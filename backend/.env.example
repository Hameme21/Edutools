# Copy to backend/.env for local development. Configure these as Render secrets in production.
PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017/edutools
BREVO_API_KEY=
# Use the exact sender email address verified in your Brevo account.
EMAIL_FROM=your-verified-email@gmail.com
# Render sets RENDER_EXTERNAL_URL automatically; it takes precedence over BACKEND_URL.
BACKEND_URL=http://localhost:3000
